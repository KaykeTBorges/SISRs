{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug leitor",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/leitor",
            "args": [
                "${workspaceFolder}/A/A-n32-k5.vrp"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "Habilita impressão de tipos no GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}